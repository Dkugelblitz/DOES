# Copy to .env.local for local development, and add the same names in Netlify (except DATABASE_URL).
# Never commit real values.

# --- Public (safe in the browser) ---
# Supabase > Project Settings > API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...). The legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Where the app is served. Used in auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only (never prefix with NEXT_PUBLIC_) ---
# The secret key (sb_secret_...). The legacy "service_role" key also works.
# Used only for the ADMIN_EMAILS bootstrap and scheduled jobs.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Comma-separated. These accounts become admins after they verify their email.
ADMIN_EMAILS=you@example.com

# --- Scripts only (migrations and seeding; not needed by Netlify) ---
# Supabase > Connect > Session pooler connection string, with your database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Email (optional; Netlify only) ---
# Used by the hourly revision-reminder job (netlify/functions/revision-reminders.mts).
# Without these, reminders still show in the app; no emails are sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
# For Gmail: an App Password (Google Account > Security > App passwords), not your normal password.
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
MAIL_FROM=DEOS <you@gmail.com>
# Random secret that signs one-click unsubscribe links. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REMINDER_SECRET=change-me
